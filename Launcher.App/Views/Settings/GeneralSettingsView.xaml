<UserControl x:Class="Launcher.App.Views.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BlockHelm_Launcher_x64;component/Views/Settings/SettingsSectionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="0,0,12,72"
                MaxWidth="{StaticResource DetailPageContentMaxWidth}"
                HorizontalAlignment="Stretch">
        <GroupBox Header="{x:Static res:Strings.Settings_MinecraftDirectoryLabel}"
                  Style="{StaticResource LauncherContentSectionStyle}">
            <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{x:Static res:Strings.Settings_MinecraftDirectoryListLabel}"
                                   Style="{StaticResource SettingsOptionTextStyle}" />

                        <Button Grid.Column="1"
                                Content="{x:Static res:Strings.Settings_AddMinecraftDirectoryButton}"
                                Command="{Binding AddMinecraftDirectoryCommand}"
                                Style="{StaticResource LauncherPrimaryDialogButtonStyle}" />
                    </Grid>

                    <TextBlock Margin="0,8,0,0"
                               Text="{x:Static res:Strings.Settings_MinecraftDirectoryChangeBlockedByActiveTasks}"
                               Foreground="{DynamicResource LauncherDangerBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsMinecraftDirectoryChangeBlocked, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />

                    <ListBox x:Name="MinecraftDirectoryListBox"
                             ItemsSource="{Binding MinecraftDirectories}"
                             SelectedItem="{Binding SelectedMinecraftDirectory, Mode=TwoWay}"
                             ItemTemplate="{StaticResource MinecraftDirectoryItemTemplate}"
                             ItemContainerStyle="{StaticResource SettingsChoiceListBoxItemStyle}"
                             Style="{StaticResource SettingsChoiceListBoxStyle}"
                             PreviewMouseLeftButtonDown="MinecraftDirectoryListBox_PreviewMouseLeftButtonDown"
                             PreviewKeyDown="MinecraftDirectoryListBox_PreviewKeyDown"
                             SelectionChanged="MinecraftDirectoryListBox_SelectionChanged" />
                </StackPanel>
            </Border>
        </GroupBox>

        <GroupBox Margin="0,26,0,0"
                  Header="{x:Static res:Strings.Settings_LauncherLogDirectoryLabel}"
                  Style="{StaticResource LauncherContentSectionStyle}">
            <Border Style="{StaticResource SectionFieldSurfaceStyle}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,12"
                               Text="{x:Static res:Strings.Settings_LauncherLogDirectoryDescription}"
                               Style="{StaticResource SettingsOptionTextStyle}" />
                    <Border Style="{StaticResource ReadOnlyFieldSurfaceStyle}">
                        <TextBlock Text="{Binding LauncherLogDirectory}"
                                   Style="{StaticResource ReadOnlyFieldTextStyle}" />
                    </Border>

                    <WrapPanel Margin="0,16,0,0">
                        <Button Margin="0,0,10,10"
                                Content="{x:Static res:Strings.Settings_OpenLauncherLogDirectoryButton}"
                                Command="{Binding OpenLauncherLogDirectoryCommand}"
                                Style="{StaticResource LauncherDialogButtonStyle}" />
                        <Button Margin="0,0,10,10"
                                Content="{x:Static res:Strings.Settings_ClearLauncherLogsButton}"
                                Command="{Binding RequestClearLauncherLogsCommand}"
                                Style="{StaticResource LauncherDialogButtonStyle}" />
                    </WrapPanel>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.Settings_DiagnosticLoggingLabel}"
                                   Style="{StaticResource SettingsOptionTextStyle}" />
                        <CheckBox Grid.Column="1"
                                  Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding DiagnosticLoggingEnabled, Mode=TwoWay}"
                                  Style="{StaticResource LauncherSwitchToggleButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </GroupBox>
    </StackPanel>
</UserControl>
