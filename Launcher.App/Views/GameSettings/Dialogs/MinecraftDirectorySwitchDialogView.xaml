<UserControl x:Class="Launcher.App.Views.GameSettings.Dialogs.MinecraftDirectorySwitchDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Launcher.App.Behaviors"
             xmlns:res="clr-namespace:Launcher.App.Resources"
             xmlns:settings="clr-namespace:Launcher.App.ViewModels.Settings"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/BlockHelm_Launcher_x64;component/Views/Settings/SettingsSectionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MinecraftDirectorySwitchItemStyle"
                   TargetType="ListBoxItem"
                   BasedOn="{StaticResource SettingsChoiceListBoxItemStyle}">
                <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
            </Style>

            <DataTemplate x:Key="MinecraftDirectorySwitchItemTemplate"
                          DataType="{x:Type settings:SettingsMinecraftDirectoryItem}">
                <StackPanel>
                    <TextBlock Text="{Binding DisplayName}"
                               ToolTip="{Binding DisplayName}"
                               behaviors:TextOverflowToolTip.IsEnabled="True"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding DirectoryPath}"
                               ToolTip="{Binding DirectoryPath}"
                               behaviors:TextOverflowToolTip.IsEnabled="True"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding AvailabilityText}"
                               Foreground="{DynamicResource LauncherDangerBrush}"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Style="{StaticResource DialogContentGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Static res:Strings.Dialog_SwitchMinecraftDirectoryTitle}"
                   Style="{StaticResource DialogTitleTextStyle}" />

        <StackPanel Grid.Row="1"
                    Margin="0,16,0,24">
            <TextBlock Text="{x:Static res:Strings.Settings_MinecraftDirectoryListLabel}"
                       Style="{StaticResource DialogBodyTextStyle}" />

            <TextBlock Margin="0,8,0,0"
                       Text="{x:Static res:Strings.Settings_MinecraftDirectoryChangeBlockedByActiveTasks}"
                       Foreground="{DynamicResource LauncherDangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsChangeBlockedByActiveTasks, Converter={StaticResource BooleanToMenuTextVisibilityConverter}}" />

            <ListBox x:Name="DirectoryListBox"
                     MaxHeight="360"
                     ItemsSource="{Binding Directories}"
                     SelectedItem="{Binding SelectedDirectory, Mode=TwoWay}"
                     ItemTemplate="{StaticResource MinecraftDirectorySwitchItemTemplate}"
                     ItemContainerStyle="{StaticResource MinecraftDirectorySwitchItemStyle}"
                     Style="{StaticResource SettingsChoiceListBoxStyle}"
                     PreviewMouseLeftButtonDown="DirectoryListBox_PreviewMouseLeftButtonDown"
                     PreviewKeyDown="DirectoryListBox_PreviewKeyDown"
                     SelectionChanged="DirectoryListBox_SelectionChanged" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Style="{StaticResource DialogFooterStyle}">
            <Button Style="{StaticResource LauncherDialogButtonStyle}"
                    Content="{x:Static res:Strings.Cancel_Button}"
                    Command="{Binding CancelCommand}" />
            <Button Margin="{StaticResource DialogTrailingButtonMargin}"
                    Style="{StaticResource LauncherPrimaryDialogButtonStyle}"
                    Content="{x:Static res:Strings.Confirm_Button}"
                    Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
